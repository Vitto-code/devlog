{
  "name": "devlog",
  "version": "0.1.0",
  "description": "Blog estatico com Next.js App Router, MDX, RSS, sitemap e busca full-text",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run search:index && next dev",
    "build": "npm run search:index && next build",
    "start": "next start",
    "search:index": "tsx scripts/build-search-index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.5.4",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
